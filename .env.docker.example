# Settings for the root docker-compose.yml. Copy to .env (git-ignored) and adjust.

# Host port for the app (client + proxied API)
APP_PORT=8080

# MySQL (container-internal; change the passwords for any real deployment)
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=sfsh
MYSQL_USER=sfsh
MYSQL_PASSWORD=sfsh_password

# Required. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Only needed if the browser reaches the API on a different origin than the client
CORS_ORIGINS=http://localhost:8080

# Syllabus analysis (https://aistudio.google.com/apikey). Leave empty + LLM_MOCK=true for offline demo.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_MOCK=false

# Demo account for `docker compose --profile seed run --rm seed`
SEED_USER_EMAIL=student@sfsh.dev
SEED_USER_PASSWORD=Password123!

# MySQL 8 connection (utf8mb4). Copy to .env and adjust.
DATABASE_URL="mysql://sfsh:sfsh_password@localhost:3306/sfsh?charset=utf8mb4"

# Demo account created by prisma/seed.js
SEED_USER_EMAIL="student@sfsh.dev"
SEED_USER_PASSWORD="Password123!"

# API
PORT=4000
# Required in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me"
# Comma-separated allowed frontend origins
CORS_ORIGINS="http://localhost:5173"

# Google Gen AI (syllabus PDF -> topics). Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Flash model used for syllabus analysis
GEMINI_MODEL="gemini-2.5-flash"
